  "homepage": "https://github.com/Anit-K-Peter/MadhuMLTT#readme",
  "devDependencies": {
    "@babel/generator": "^8.0.5",
    "@babel/parser": "^8.0.5",
    "@babel/traverse": "^8.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "magic-string": "^1.3.1",
    "react": "^19.3.0",
