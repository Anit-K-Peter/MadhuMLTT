{
  "name": "@madhu-mltt/react",
  "version": "0.1.4",
  "description": "React integration layer for Madhu ML TT Malayalam text technology engine",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./runtime": {
      "types": "./src/runtime.d.ts",
      "default": "./src/runtime.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@madhu-mltt/core": "^0.1.2"
  },
  "keywords": [
    "malayalam",
    "ml-tt",
    "react",
    "karthika",
    "font-encoding",
    "unicode",
    "mltt"
  ],
  "author": "Anit K Peter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anit-K-Peter/MadhuMLTT.git"
  },
  "bugs": {
    "url": "https://github.com/Anit-K-Peter/MadhuMLTT/issues"
  },
  "homepage": "https://github.com/Anit-K-Peter/MadhuMLTT#readme"
}
